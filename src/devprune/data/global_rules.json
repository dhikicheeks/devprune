[
  {"group": "pnpm / Node", "label": "pnpm store (prune)", "path": "~/Library/pnpm/store", "path_from_cmd": ["pnpm", "store", "path"],
   "requires": "pnpm", "cmd": ["pnpm", "store", "prune"], "fallback_delete": true, "risk": "safe",
   "note": "Removes packages no project uses (safe)."},
  {"group": "pnpm / Node", "label": "pnpm metadata cache", "path": "~/Library/Caches/pnpm", "risk": "safe",
   "note": "Registry metadata cache."},
  {"group": "pnpm / Node", "label": "npm cache", "path": "~/.npm/_cacache",
   "requires": "npm", "cmd": ["npm", "cache", "clean", "--force"], "fallback_delete": true, "risk": "safe",
   "note": "npm download cache."},
  {"group": "pnpm / Node", "label": "Yarn cache", "path": "~/Library/Caches/Yarn", "risk": "safe",
   "note": "Yarn download cache."},
  {"group": "pnpm / Node", "label": "node-gyp cache", "path": "~/Library/Caches/node-gyp", "risk": "safe",
   "note": "Native build headers."},

  {"group": "Laravel / PHP", "label": "Composer cache", "path": ["~/.composer/cache", "~/Library/Caches/composer"],
   "requires": "composer", "cmd": ["composer", "clear-cache"], "fallback_delete": true, "risk": "safe",
   "note": "Composer package cache."},

  {"group": "Flutter / Mobile", "label": "Dart pub cache", "path": "~/.pub-cache",
   "requires": "dart", "cmd": ["dart", "pub", "cache", "clean", "--force"], "fallback_delete": true, "risk": "medium",
   "note": "Downloaded Dart packages (via `dart pub cache clean`). Projects need `flutter pub get` again."},
  {"group": "Flutter / Mobile", "label": "Xcode DerivedData", "path": "~/Library/Developer/Xcode/DerivedData", "risk": "safe",
   "note": "Xcode build output."},
  {"group": "Flutter / Mobile", "label": "Xcode iOS DeviceSupport", "path": "~/Library/Developer/Xcode/iOS DeviceSupport", "risk": "medium",
   "note": "Old device symbols; regenerated when a device is connected."},
  {"group": "Flutter / Mobile", "label": "Xcode Archives", "path": "~/Library/Developer/Xcode/Archives", "risk": "careful",
   "note": "Release archives. Make sure you no longer need them (dSYMs are needed for crash logs)."},
  {"group": "Flutter / Mobile", "label": "iOS Simulator (unavailable)", "path": "~/Library/Developer/CoreSimulator",
   "requires": "xcrun", "cmd": ["xcrun", "simctl", "delete", "unavailable"], "fallback_delete": false, "risk": "safe",
   "note": "Only removes simulators that are no longer available."},
  {"group": "Flutter / Mobile", "label": "CocoaPods cache", "path": "~/Library/Caches/CocoaPods", "risk": "safe",
   "note": "Pods download cache."},
  {"group": "Flutter / Mobile", "label": "Gradle caches", "path": "~/.gradle/caches", "guard": "gradle", "risk": "medium",
   "note": "Gradle downloads; the next Android build is slower. Refused while a Gradle daemon is running."},
  {"group": "Flutter / Mobile", "label": "Android build-cache", "path": "~/.android/build-cache", "risk": "safe",
   "note": "Android build cache."},

  {"group": "System", "label": "Homebrew cache", "path": "~/Library/Caches/Homebrew",
   "requires": "brew", "cmd": ["brew", "cleanup", "-s"], "fallback_delete": true, "risk": "safe",
   "note": "Old formula downloads."},
  {"group": "System", "label": "User logs", "path": "~/Library/Logs", "risk": "safe",
   "note": "Application logs in ~/Library/Logs."},
  {"group": "System", "label": "Trash", "path": "~/.Trash", "risk": "careful",
   "note": "Contents of the Trash (permanent!)."}
]
