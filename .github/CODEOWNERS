# Files where one wrong line can make DevPrune delete something it should not,
# or open the local server to other websites. A pull request that touches any
# of them asks the owner for a review.
#
# Today only the owner can merge, so this is a marker. When there are
# collaborators, turn on "Require review from Code Owners" in the branch
# protection rules and it becomes a gate.

# What may be deleted, and how
/src/devprune/safety.py       @dhikicheeks
/src/devprune/clean.py        @dhikicheeks
/src/devprune/trash.py        @dhikicheeks
/src/devprune/rules.py        @dhikicheeks
/src/devprune/config.py       @dhikicheeks
/src/devprune/cache.py        @dhikicheeks
/src/devprune/data/*.json     @dhikicheeks

# The local server, its token and its allow-list, process handling, launchers
/src/devprune/server.py       @dhikicheeks
/src/devprune/lifecycle.py    @dhikicheeks
/src/devprune/launcher.py     @dhikicheeks

# The tests that guard the files above: weakening a test is as risky as weakening the code
/tests/test_safety.py         @dhikicheeks
/tests/test_trash.py          @dhikicheeks
/tests/test_clean.py          @dhikicheeks
/tests/test_clean_staging.py  @dhikicheeks
/tests/test_rules_config.py   @dhikicheeks

# CI, packaging and the security policy
/.github/                     @dhikicheeks
/pyproject.toml               @dhikicheeks
/SECURITY.md                  @dhikicheeks
/LICENSE                      @dhikicheeks
